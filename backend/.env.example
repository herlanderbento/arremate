# Usado pelo docker-compose no contentor do Postgres e no DATABASE_URL da API.
# Um volume já existente mantém a senha com que foi criado.
POSTGRES_PASSWORD=
# Execução local fora do Docker (o compose substitui este valor no serviço da API).
DATABASE_URL=postgresql+asyncpg://arremate:<POSTGRES_PASSWORD>@localhost:5433/arremate
ENV=development
# Regista as instruções SQL (os parâmetros ficam sempre ocultos)
SQL_ECHO=false

# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# Chave HMAC da cadeia de lances e dos pseudónimos dos licitantes. Nunca é gravada na base de dados;
# trocá-la faz todos os lotes existentes aparecerem como TAMPERED.
AUDIT_SECRET=

# Origens do front-end, separadas por vírgula
CORS_ORIGINS=http://localhost:3000
# Só para desenvolvimento local em http; mantém true em qualquer outro ambiente.
COOKIE_SECURE=false
# lax no local; none em produção quando o front-end e a API estão em sites diferentes
COOKIE_SAMESITE=lax

CATALOG_BASE_URL=https://api.artic.edu/api/v1
